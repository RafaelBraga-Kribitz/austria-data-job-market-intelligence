ref table 'Skill by Region'
ref table 'Skill Stack'
ref table 'Pay Floor by Family'
ref table Seniority
ref table 'Pay Floor by State'
ref table 'Salary Evidence'
ref table 'Decision Matrix'
ref table 'Weighting Rank'
ref table 'Capability Evidence'
ref table Source
ref table 'Title Precision'
ref table 'Population Funnel'
ref table Duplicates
ref table Snapshot
ref table Measures
