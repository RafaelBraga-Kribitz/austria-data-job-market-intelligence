/// De-duplication metrics (outputs/tables/Q04_duplicates.csv).
table Duplicates
	lineageTag: 2437065c-0542-586b-a580-6baacd8ad294

	/// Metric key, e.g. core_groups, cross_source_groups_core.
	column Metric
		dataType: string
		lineageTag: 98020766-b3ec-5d66-b778-994f555a285a
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = User

	/// Metric value.
	column Value
		dataType: double
		isHidden
		formatString: #,0.###
		lineageTag: f8bc3068-6ed3-53fd-9d76-63ac4df5bd98
		summarizeBy: sum
		sourceColumn: Value

		annotation SummarizationSetBy = User

	partition Duplicates = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ExportsPath & "tables\Q04_duplicates.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"metric", type text}, {"value", type number}}, "en-US"),
					Renamed = Table.RenameColumns(Typed, {{"metric", "Metric"}, {"value", "Value"}}),
					Result = Table.SelectColumns(Renamed, {"Metric", "Value"})
				in
					Result

	annotation PBI_ResultType = Table
