# .gitignore of the PUBLIC repository (written by src/publish/export_public.py; edit it there, not in the public clone).
# The public tree carries code, methodology and aggregates only. Anything a reader collects or downloads
# locally stays out of git by default; only the openly licensed Eurostat raw data is published.

# Python and tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
*.tmp
logs/

# Local data (source records are never part of this repository; see PUBLICATION_DECISION.md)
data/raw/*
!data/raw/.gitkeep
!data/raw/eurostat_jvs/
!data/raw/eurostat_supply/
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/labels/
data/private/

# Local databases
*.db
*.sqlite
*.sqlite3
